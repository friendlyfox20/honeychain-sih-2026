APP_NAME="HoneyChain Backend"
ENVIRONMENT="development"

# Database Configuration
# Leave blank to use the zero-configuration local SQLite database (backend/honeychain_dev.db).
# To connect to an external PostgreSQL server in production, provide the connection URI:
# DATABASE_URL="postgresql://user:password@localhost:5432/honeychain_db"
DATABASE_URL=""

MODEL_DIR="../models"
DATASET_PATH="../DAT/Honey_Production_Dataset_for_2024.csv"

# JWT Authentication
JWT_SECRET_KEY="supersecret_honeychain_key_change_in_production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
